{
  "name": "jakesjam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "bun run --filter client dev",
    "dev:client": "bun run --filter client dev",
    "dev:convex": "bunx convex dev --local",
    "dev:server": "bun run --filter server dev",
    "dev:full": "bunx convex dev --local --start 'bun run --filter client dev'",
    "dev:online": "bunx convex dev --local --start 'bun run --filter server dev & bun run --filter client dev'",
    "typecheck": "bun run --filter client typecheck && bun run --filter server typecheck && bun run typecheck:convex",
    "typecheck:convex": "bunx convex codegen --typecheck enable",
    "build": "bun run --filter client build",
    "build:standalone": "bun run --filter client build && bun tools/build-standalone.mjs",
    "verify": "bun run typecheck && bun run build",
    "test": "bun run --filter '*' test --if-present",
    "e2e": "bunx playwright test",
    "e2e:ui": "bunx playwright test --ui",
    "e2e:headed": "bunx playwright test --headed",
    "convex:codegen": "bunx convex codegen",
    "convex:deploy": "bunx convex deploy",
    "deploy:server:syd": "flyctl deploy --config fly.toml --app jakesjam-srv-syd",
    "sim:build": "cd sim && zig build",
    "sim:test": "cd sim && zig build test",
    "sim:fmt": "cd sim && zig fmt --check .",
    "sim:bench": "bun run tools/wasm-bench.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/pngjs": "^6.0.5",
    "convex": "^1.37.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
