{
  "name": "jakesjam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "data-warehouse"
  ],
  "scripts": {
    "dev": "bun run --filter client dev",
    "dev:client": "bun run --filter client dev",
    "dev:convex": "bunx convex dev --local",
    "dev:server": "bun run --filter server dev",
    "dev:full": "bunx convex dev --local --start 'bun run --filter client dev'",
    "dev:online": "bunx convex dev --local --start 'bun run --filter server dev & bun run --filter client dev'",
    "typecheck": "bun run --filter client typecheck && bun run --filter server typecheck && bun run typecheck:convex",
    "typecheck:convex": "bunx convex codegen --typecheck enable",
    "build": "bun run --filter client build",
    "build:standalone": "bun run --filter client build && bun tools/build-standalone.mjs",
    "verify": "bun run typecheck && bun run build",
    "test": "bun run --filter '*' test --if-present",
    "e2e": "bunx playwright test",
    "e2e:ui": "bunx playwright test --ui",
    "e2e:headed": "bunx playwright test --headed",
    "convex:codegen": "bunx convex codegen",
    "convex:deploy": "bunx convex deploy",
    "deploy:server:sin": "flyctl deploy --config fly.toml --app jakesjam-srv-sin",
    "sim:build": "bun run gen:cards && cd sim && zig build",
    "sim:test": "cd sim && zig build test",
    "sim:fmt": "cd sim && zig fmt --check .",
    "sim:bench": "bun run tools/wasm-bench.ts",
    "host:public": "./scripts/host-public.sh",
    "combat:probe": "bun tools/combat-probe.mjs",
    "match:probe": "bun tools/match-probe.mjs",
    "gen:cards": "bun run sim/tools/gen_card_data.ts",
    "autoplay": "bun scripts/autoplay.ts",
    "autoplay:heavy": "bun scripts/autoplay.ts --heavy",
    "presentation:evidence": "bun scripts/audit-presentation-evidence.ts",
    "presentation:extract-frames": "bun scripts/extractPresentationFrames.ts",
    "presentation:rig-evidence": "bun scripts/rigHarnessShots.ts",
    "presentation:loadout-evidence": "bun scripts/loadoutHarnessShots.ts",
    "presentation:lobby-vfx-parity": "bun scripts/lobbyVfxParityShots.ts",
    "balance-sim": "bun scripts/balance-sim.ts",
    "clips:migrate-r2": "bun scripts/migrate-clips-to-r2.ts",
    "clips:migrate-r2:dry-run": "bun scripts/migrate-clips-to-r2.ts --dry-run",
    "passport": "./scripts/passport.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/pngjs": "^6.0.5",
    "convex": "^1.37.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
