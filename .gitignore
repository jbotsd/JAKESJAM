# Zig sim build artifacts. `zig build` writes sim.wasm to two paths:
#   - client/public/wasm/sim.wasm — Vite copies to dist/ at runtime
#   - client/src/sim/wasm/sim.wasm — Bun tests resolve from here
client/src/sim/wasm/sim.wasm
client/public/wasm/sim.wasm
sim/zig-out/
sim/.zig-cache/
sim/zig-cache/
.host-logs/
.combat-probe/
.match-probe/

# Highlight-clip uploads (server/src/clipStore.ts) — runtime data, not source
server/.clips/
server/.clips-host/
server/.replays/
server/.tiktok/
server/.entitlements/
server/.signups/
server/.clips-quarantine/
server/.telemetry/
# Data warehouse — rebuilt locally from the sources above + fresh research
# agent runs (bun data-warehouse/ingest.ts), never hand-edited, so it's a
# build artifact like any other, not something to diff/merge in git.
data-warehouse/jakesjam.db
data-warehouse/jakesjam.db-shm
data-warehouse/jakesjam.db-wal
# Same runtime-data categories, but at repo root (client-side clip capture /
# publishing state) — same reasoning as the server/ ones above.
/.clips/
/.tiktok/
/.entitlements/
/.signups/
*.m4a.bak
# Auto-captured host replay screenshots — generated review artifacts, not
# authored docs; regenerate on demand rather than tracking in git history.
docs/clip-sheets/
elm-stuff/
# stream-kit runtime junk
__pycache__/
stream-kit/obs/*.bak-*

# Portal submission build (scripts/build-portal-zip.sh output) — rebuilt
# on demand, never hand-edited, so it's a build artifact like dist/.
dist-portal/
jakesjam-portal-build.zip

# scripts/balance-sim.ts JSON report — regenerated on every run, not
# authored data.
scripts/.balance-sim-report.json
