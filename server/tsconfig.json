{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@sim/*": ["../client/src/sim/*"],
      "@net/*": ["../client/src/net/*"]
    }
  },
  "include": ["src/**/*.ts", "../client/src/sim/**/*.ts", "../client/src/net/**/*.ts"]
}
