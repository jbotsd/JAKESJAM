# Copy values from `bunx convex dev` into client/.env.local for browser testing.
# VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# Optional override of the game server URL the client connects to. By default
# the client gets the URL from convex/matchmaker.getMyMatchToken (which points
# at the Fly.io regional deploy). Use this to point local Vite at a local Bun
# server, or at a staging environment.
# VITE_GAME_SERVER_URL=ws://localhost:8080/ws
